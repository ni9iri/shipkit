# Copy to .env and fill in. Never commit .env.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postgres (Neon or local). Used by the app and the Prisma CLI.
DATABASE_URL="postgresql://user:password@localhost:5432/shipkit"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=
# Google OAuth client; redirect URI: <site>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Resend API key (magic-link sign-in + purchase email)
AUTH_RESEND_KEY=
# Sender on a domain verified in Resend
EMAIL_FROM="ShipKit <hello@yourdomain.com>"

# Stripe
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/stripe/webhook` or the dashboard endpoint
STRIPE_WEBHOOK_SECRET=
# One-time Price IDs for each plan in src/config.ts
STRIPE_PRICE_STARTER=
STRIPE_PRICE_ALLIN=
